#!/usr/bin/env bash
# st launcher: /usr/bin/st (Gentoo, anygeometry + xresources-signal-reload
# patches) starts maximized. st itself has no "maximize" option, so the
# window is pre-sized in pixels to the Cinnamon work area and then marked
# maximized. The work area is read from a window the WM already maximized
# (Cinnamon's _NET_WORKAREA property is wrong/stale here), so the first
# painted frame is already the full final size and the maximize is a no-op:
# no resize, no animation, no flicker.
set -euo pipefail

ST_BIN=/usr/bin/st
command -v xdotool >/dev/null || exec "$ST_BIN" "$@"

# exact work area from any window the WM already maximized
work=""
for w in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -oE '0x[0-9a-f]+' || true); do
    xprop -id "$w" _NET_WM_STATE 2>/dev/null | grep -q MAXIMIZED || continue
    g=$(xdotool getwindowgeometry --shell "$w" 2>/dev/null) || continue
    ww=$(sed -n 's/^WIDTH=//p'  <<<"$g")
    wh=$(sed -n 's/^HEIGHT=//p' <<<"$g")
    [[ "$ww" =~ ^[0-9]+$ && "$wh" =~ ^[0-9]+$ ]] || continue
    (( ww >= 320 && wh >= 200 )) || continue
    work="${ww}x${wh}"
    break
done

if [[ -n "$work" ]]; then
    "$ST_BIN" -G "$work" "$@" &
else
    # nothing maximized yet on this workspace: start normal and maximize
    "$ST_BIN" "$@" &
fi
pid=$!

# st sets _NET_WM_PID, so the new window can be found by PID
win=""
for _ in $(seq 1 40); do
    win=$(xdotool search --onlyvisible --pid "$pid" 2>/dev/null | head -n1 || true)
    [[ -n "$win" ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
done
if [[ -n "$win" ]]; then
    # xdotool takes the window as an option, not positionally
    xdotool windowstate --add maximized_vert maximized_horz --window "$win" 2>/dev/null \
        || wmctrl -i -r "$win" -b add,maximized_vert,maximized_horz 2>/dev/null || true
fi

wait "$pid"