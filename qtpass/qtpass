#!/bin/sh
# qtpass wrapper: force the GTK3 platform theme so the first painted frame
# already matches the system theme (otherwise Qt paints a dark default
# palette first and re-themes moments later — visible "black flash").
export QT_QPA_PLATFORMTHEME=gtk3
export QT_PLUGIN_PATH=/usr/lib64/qt6/plugins
exec /usr/bin/qtpass "$@"
